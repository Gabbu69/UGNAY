# Copy this file to .env before running Docker Compose.
COMPOSE_PROJECT_NAME=ugnay

# Local bind addresses and ports. Keep stateful services on loopback.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
MYSQL_BIND_ADDRESS=127.0.0.1
MYSQL_PUBLISHED_PORT=3307
MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_BIND_ADDRESS=127.0.0.1
CLAMAV_PUBLISHED_PORT=3310

# MySQL 8.4
MYSQL_DATABASE=ugnay
MYSQL_USER=ugnay_app
MYSQL_PASSWORD=replace-with-a-long-random-password
MYSQL_ROOT_PASSWORD=replace-with-a-different-long-random-password

# MinIO private object storage
MINIO_ROOT_USER=ugnay_minio
MINIO_ROOT_PASSWORD=replace-with-another-long-random-password
MINIO_BUCKET=ugnay-documents
MINIO_APP_ACCESS_KEY=ugnay_storage_app
MINIO_APP_SECRET_KEY=replace-with-a-dedicated-storage-password

# Persistent bootstrap identity: created in MySQL only when this email is absent.
# Set the final password before the first start; changing it here does not rotate an existing account.
UGNAY_BOOTSTRAP_ADMIN_EMAIL=admin@ugnay.local
UGNAY_BOOTSTRAP_ADMIN_PASSWORD=ChangeMe!UGNAY2026
UGNAY_PUBLIC_DEMO_READ=false
UGNAY_COOKIE_SECURE=false

# Upload and extraction limits
UGNAY_MAX_UPLOAD_SIZE=50MB
UGNAY_TIKA_MAX_CHARACTERS=2000000
UGNAY_TIKA_TIMEOUT_SECONDS=120

# Local semantic model. Blank values deliberately select PARTIAL lexical mode.
# After scripts/fetch-model.ps1 succeeds, copy the exact values it prints here.
UGNAY_EMBEDDING_MODEL_PATH=
UGNAY_EMBEDDING_MODEL_SHA256=
UGNAY_EMBEDDING_TOKENIZER_PATH=
UGNAY_EMBEDDING_TOKENIZER_SHA256=
# UGNAY_EMBEDDING_MODEL_PATH=/opt/ugnay/models/multilingual-e5-small/onnx/model.onnx
# UGNAY_EMBEDDING_MODEL_SHA256=ca456c06b3a9505ddfd9131408916dd79290368331e7d76bb621f1cba6bc8665
# UGNAY_EMBEDDING_TOKENIZER_PATH=/opt/ugnay/models/multilingual-e5-small/onnx/tokenizer.json
# UGNAY_EMBEDDING_TOKENIZER_SHA256=0b44a9d7b51c3c62626640cda0e2c2f70fdacdc25bbbd68038369d14ebdf4c39

# Optional Caddy pilot profile: docker compose --profile pilot up -d
UGNAY_DOMAIN=ugnay.example.edu
CADDY_ACME_EMAIL=research-office@example.edu
HTTP_PORT=80
HTTPS_PORT=443

# Operations tooling. Scripts set these automatically when needed.
UGNAY_BACKUP_PATH=./.backups
MINIO_OPERATION=verify
MINIO_BACKUP_NAME=unused
