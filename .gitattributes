* text=auto

# Packaged text resources must be byte-identical on Windows and Linux.
*.java text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.properties text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.md text eol=lf
*.sh text eol=lf

# Native Windows entrypoints stay CRLF for older command hosts.
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

*.jar binary
*.onnx binary
*.zip binary
*.woff2 binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
